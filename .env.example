# --- the cloud (only the server needs these) ---------------------------------
GEMINI_API_KEY=
# Several Gemini keys at the same time (separated by a comma). Every key has
# its own quota: a key that runs out is skipped at once and the next one
# answers. The key above stays the first one of the list.
GEMINI_API_KEYS=
# The current stable Flash models are gemini-3.8-flash and gemini-3.6-flash
# (gemini-2.0-flash was shut down on 1 June 2026).
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
WOLFRAM_APP_ID=

# --- the Aieva server --------------------------------------------------------
AIEVA_SERVER_URL=http://127.0.0.1:8000
# The shared key the app sends as the X-Aieva-Key header (server side).
AIEVA_SERVER_KEY=
AIEVA_SERVER_TIMEOUT=30
# Canned answers - no API key needed (the demo and the tests use this).
AIEVA_MOCK_LLM=false

# --- the device --------------------------------------------------------------
AIEVA_OFFLINE_MODE=false
AIEVA_CACHE_DIR=.aieva_cache
AIEVA_OCR_INBOX=ocr_inbox
AIEVA_OCR_OUTBOX=ocr_outbox

# --- the background service of the board -----------------------------------
# What is watched: auto (the screen, otherwise the folder), desktop, folder.
AIEVA_SERVICE_SOURCE=auto
# How often the board is looked at (seconds) and the shortest pause between
# two readings.
AIEVA_SERVICE_INTERVAL=2
AIEVA_SERVICE_MIN_INTERVAL=2
# How much the board has to change before it is read again (0 - 1).
AIEVA_SERVICE_THRESHOLD=0.004
# The safety limit: the most readings per minute.
AIEVA_SERVICE_MAX_RUNS=12
# The folder with the pictures of the board and where the results are written.
AIEVA_SERVICE_FOLDER=ocr_inbox
AIEVA_SERVICE_OUTBOX=ocr_outbox
# The status file of the service.
AIEVA_SERVICE_STATE=.aieva_cache/service_state.json
# Solve the reading, draw it, show it in the floating window.
AIEVA_SERVICE_SOLVE=true
AIEVA_SERVICE_PLOT=true
AIEVA_SERVICE_OVERLAY=true
AIEVA_SERVICE_OVERLAY_SECONDS=8
# The key that reads the board on the spot (F8 - more keys with a comma).
AIEVA_SERVICE_HOTKEY=f8
# Canned OCR - no API key needed (the demo and the tests use this).
AIEVA_SERVICE_MOCK=false
