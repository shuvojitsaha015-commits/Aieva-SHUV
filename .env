# --- the cloud (only the server needs these) ---------------------------------
GEMINI_API_KEY=
# The current stable Flash models are gemini-3.8-flash and gemini-3.6-flash
# (gemini-2.0-flash was shut down on 1 June 2026).
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
WOLFRAM_APP_ID=

# --- the Aieva server --------------------------------------------------------
AIEVA_SERVER_URL=http://127.0.0.1:8000
# The shared key the app sends as the X-Aieva-Key header (server side).
AIEVA_SERVER_KEY=
AIEVA_SERVER_TIMEOUT=30
# Canned answers - no API key needed (the demo and the tests use this).
AIEVA_MOCK_LLM=false

# --- the device --------------------------------------------------------------
AIEVA_OFFLINE_MODE=false
AIEVA_CACHE_DIR=.aieva_cache
AIEVA_OCR_INBOX=ocr_inbox
AIEVA_OCR_OUTBOX=ocr_outbox
